# Copy to .env.local (gitignored) for local development. Nothing in this file is
# a secret: token verification needs no Clerk secret key, and the publishable
# key ships in the browser bundle.

# Written by `bun run convex` (convex dev). Leave it to the CLI.
VITE_CONVEX_URL=

# Clerk publishable key for this environment. Development instances issue
# pk_test_…; production issues pk_live_…. The only sign-in variable the frontend
# has — both environments run the same two strategies (email verification code,
# Google), so nothing else distinguishes them.
VITE_CLERK_PUBLISHABLE_KEY=

# --- Convex deployment environment variables (NOT read from this file) -------
# Set on the deployment itself, per environment:
#
#   bunx convex env set CLERK_JWT_ISSUER_DOMAIN https://<slug>.clerk.accounts.dev
#   bunx convex env set CLERK_JWT_ISSUER_DOMAIN https://clerk.<domain> --prod
#
# It is Clerk's Frontend API URL, and must equal the token's `iss` exactly.
# Without it every call is anonymous and the backend denies everything.
#
#   bunx convex env set ALLOWED_EMAIL_DOMAIN vctusa.com --prod    # optional
#
# The employee admission gate. Set, only a verified address at that domain may
# hold an account; unset, any verified sign-in becomes a zero-access Member
# waiting on an Administrator's grant. It needs the `email_verified` session
# claim mapped in Clerk, or it refuses everyone — docs/runbooks/clerk-setup.md.
