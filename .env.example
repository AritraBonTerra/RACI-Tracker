# Local development only. Copy to .env.local if that file does not exist.
# Select/create the local backend using docs/runbooks/environments.md.
# Convex writes CONVEX_DEPLOYMENT and the two URLs below when you select it.
VITE_CONVEX_URL=http://127.0.0.1:3210
VITE_CONVEX_SITE_URL=http://127.0.0.1:3211

# Clerk development publishable key. The app uses email codes or Google sign-in.
# No Clerk secret key or Convex deploy key is needed to run the local app.
VITE_CLERK_PUBLISHABLE_KEY=

# Set these ON the local Convex backend, not in this file, while it is running:
# bunx convex env set CLERK_JWT_ISSUER_DOMAIN https://<slug>.clerk.accounts.dev --deployment local
# Optional admission gate:
# bunx convex env set ALLOWED_EMAIL_DOMAIN bonterraorganic.com --deployment local
# See docs/runbooks/clerk-setup.md for the matching Clerk token claims.
# Staging uses a separate file: .env.staging.local. See .env.staging.example.
