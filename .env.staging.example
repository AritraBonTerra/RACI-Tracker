# Optional manual staging deployment. Copy to .env.staging.local, never .env.local.
# Keep the real file gitignored. The usual release path is a push to staging.
# Create a staging-only key without printing it:
# bunx convex deployment token create manual-staging --deployment aritra-das-44117:raci-tracker:staging --save-env .env.staging.local
CONVEX_DEPLOY_KEY=

# Use the same Clerk development publishable key as local development.
VITE_CLERK_PUBLISHABLE_KEY=
VITE_CONVEX_URL=https://flippant-jaguar-524.convex.cloud

# Deploy with the explicit file so local development remains on localhost:
# bunx convex deploy --env-file .env.staging.local --cmd 'bun run build' --cmd-url-env-var-name VITE_CONVEX_URL
