{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": [
      "src/**",
      "convex/**",
      "tests/**",
      "checks/**",
      "*.ts",
      "*.json",
      "!convex/_generated"
    ]
  },
  "css": { "parser": { "tailwindDirectives": true } },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": { "quoteStyle": "double", "trailingCommas": "all", "semicolons": "always" }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "a11y": {
        "noAutofocus": "off",
        "useValidAriaRole": { "level": "error", "options": { "ignoreNonDom": true } }
      },
      "suspicious": { "noExplicitAny": "error", "noArrayIndexKey": "off" },
      "style": { "noNonNullAssertion": "warn" }
    }
  },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
