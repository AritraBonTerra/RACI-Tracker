{
  "name": "raci-tracker",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "convex": "convex dev",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "biome check . && tsc --noEmit && vitest run"
  },
  "dependencies": {
    "@clerk/clerk-react": "^5.61.3",
    "convex": "^1.45.0",
    "convex-helpers": "^0.1.123",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "convex-test": "^0.0.56",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^4.1.11"
  }
}
